# Copia este archivo como backend/.env SOLO para trabajar en tu computador.
# En Vercel estas variables se cargan en Settings > Environment Variables.

# Conexión a Postgres. En Vercel la crea sola la integración de Neon.
# En local: copia la "Connection string" desde la consola de Neon.
DATABASE_URL=

# Secreto para firmar las sesiones: al menos 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Contraseña de la cuenta Cintac_Admin que se crea sola la primera vez
# (mínimo 12 caracteres, con letras y números).
ADMIN_INITIAL_PASSWORD=

PORT=4000

# Dominios de correo que pueden crear cuenta desde "Crear una cuenta" (separados por coma).
# Recomendado en producción: cintac.cl  (vacío = cualquier correo puede registrarse).
REGISTRO_DOMINIOS_PERMITIDOS=
CORS_ORIGIN=http://localhost:5173

# Opcional: correo para recuperación de contraseña y aprobación de roles.
ADMIN_APPROVAL_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: cuenta superadministradora.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_INITIAL_PASSWORD=
SUPERADMIN_NAME=CINTAC Superadmin
