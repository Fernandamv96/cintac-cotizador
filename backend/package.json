{
  "name": "cintac-cotizador-backend",
  "version": "1.0.0",
  "description": "Backend del cotizador de flete de importación marítima - Cintac (Express + PostgreSQL/Neon)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
